{"screenId":"31d0b2f3dba24918aa94730f7f64c17a","projectId":"2689100580676332260","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    colors: {\n                        \"on-secondary\": \"#1d314c\",\n                        \"error\": \"#ffb4ab\",\n                        \"surface-container-highest\": \"#333539\",\n                        \"on-tertiary-container\": \"#451f00\",\n                        \"on-secondary-fixed-variant\": \"#354863\",\n                        \"surface-container-low\": \"#1a1c20\",\n                        \"tertiary-fixed\": \"#ffdcc6\",\n                        \"secondary-fixed\": \"#d4e3ff\",\n                        \"primary-fixed-dim\": \"#acc7ff\",\n                        \"primary-container\": \"#468fff\",\n                        \"on-secondary-fixed\": \"#061c36\",\n                        \"on-secondary-container\": \"#a6b9da\",\n                        \"surface-tint\": \"#acc7ff\",\n                        \"surface-container-high\": \"#282a2e\",\n                        \"surface\": \"#111317\",\n                        \"on-surface\": \"#e2e2e8\",\n                        \"tertiary-container\": \"#df7306\",\n                        \"primary\": \"#acc7ff\",\n                        \"surface-container\": \"#1e2024\",\n                        \"background\": \"#111317\",\n                        \"secondary-container\": \"#374a66\",\n                        \"tertiary\": \"#ffb784\",\n                        \"inverse-surface\": \"#e2e2e8\",\n                        \"inverse-on-surface\": \"#2f3035\",\n                        \"on-background\": \"#e2e2e8\",\n                        \"surface-bright\": \"#37393e\",\n                        \"secondary-fixed-dim\": \"#b4c8e9\",\n                        \"on-primary-container\": \"#00285a\",\n                        \"outline\": \"#8b919f\",\n                        \"on-primary\": \"#002f67\",\n                        \"on-primary-fixed-variant\": \"#004591\",\n                        \"on-primary-fixed\": \"#001a40\",\n                        \"primary-fixed\": \"#d7e2ff\",\n                        \"on-error\": \"#690005\",\n                        \"surface-variant\": \"#333539\",\n                        \"outline-variant\": \"#414754\",\n                        \"on-error-container\": \"#ffdad6\",\n                        \"on-tertiary-fixed\": \"#301400\",\n                        \"surface-container-lowest\": \"#0c0e12\",\n                        \"tertiary-fixed-dim\": \"#ffb784\",\n                        \"secondary\": \"#b4c8e9\",\n                        \"on-tertiary\": \"#502500\",\n                        \"inverse-primary\": \"#005cbd\",\n                        \"error-container\": \"#93000a\",\n                        \"on-surface-variant\": \"#c1c6d6\",\n                        \"surface-dim\": \"#111317\",\n                        \"on-tertiary-fixed-variant\": \"#713700\"\n                    },\n                    fontFamily: {\n                        \"headline\": [\"Manrope\"],\n                        \"body\": [\"Inter\"],\n                        \"label\": [\"Inter\"]\n                    },\n                    borderRadius: { \"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\" },\n                },\n            },\n        }\n    </script>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        body {\n            background-color: #111317;\n            color: #e2e2e8;\n            font-family: 'Inter', sans-serif;\n        }\n        .editorial-shadow {\n            box-shadow: 0 32px 64px rgba(226, 226, 232, 0.06);\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"min-h-screen pb-32\">\n<!-- TopAppBar -->\n<header class=\"w-full top-0 sticky bg-[#111317] dark:bg-[#111317] z-50\">\n<div class=\"flex items-center justify-between px-6 py-4 w-full\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-[#acc7ff] dark:text-[#acc7ff]\">account_circle</span>\n</div>\n<h1 class=\"font-['Manrope'] uppercase tracking-widest text-xs font-bold text-[#acc7ff] dark:text-[#acc7ff]\">Nocturnal Sanctuary</h1>\n<div class=\"w-6\"></div> <!-- Spacer for center alignment -->\n</div>\n</header>\n<main class=\"px-6 pt-8 space-y-12\">\n<!-- Summary Card: The Circadian Pulse -->\n<section class=\"relative overflow-hidden rounded-xl p-8 bg-surface-container-high editorial-shadow border border-outline-variant/10\">\n<div class=\"absolute top-0 right-0 -mt-10 -mr-10 w-48 h-48 bg-primary/20 blur-[80px] rounded-full\"></div>\n<div class=\"relative z-10 space-y-6\">\n<div>\n<span class=\"text-xs font-bold uppercase tracking-widest text-primary/70 font-headline\">Upcoming Shift</span>\n<h2 class=\"text-3xl font-extrabold font-headline leading-tight tracking-tighter text-on-surface mt-2\">\n                        Night Shift starts at 19:00\n                    </h2>\n</div>\n<div class=\"flex items-center gap-4\">\n<div class=\"px-4 py-2 bg-surface-bright/40 backdrop-blur-md rounded-full border border-outline-variant/10\">\n<span class=\"text-xs font-medium text-on-surface/80\">Prep begins in 4h 12m</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Main Content: Next 7 Days Editorial List -->\n<section class=\"space-y-8\">\n<div class=\"flex justify-between items-end\">\n<h3 class=\"text-2xl font-bold font-headline tracking-tight text-on-surface\">Schedule</h3>\n<span class=\"text-xs font-semibold text-primary/60 font-label tracking-widest uppercase\">Oct 24 — Oct 30</span>\n</div>\n<div class=\"space-y-6\">\n<!-- Day 1: Shift -->\n<div class=\"flex items-center gap-6 group\">\n<div class=\"w-12 flex flex-col items-center\">\n<span class=\"text-[10px] font-bold uppercase tracking-tighter text-on-surface/40\">Mon</span>\n<span class=\"text-xl font-bold font-headline text-on-surface\">24</span>\n</div>\n<div class=\"flex-1 h-20 bg-primary/90 rounded-xl p-5 flex justify-between items-center transition-transform duration-300 hover:scale-[1.02] active:scale-95 shadow-lg shadow-primary/10\">\n<div class=\"space-y-1\">\n<span class=\"text-[10px] font-bold uppercase tracking-widest text-on-primary/70 block\">Shift Duration</span>\n<span class=\"text-lg font-bold font-headline text-on-primary\">19:00 — 07:00</span>\n</div>\n<span class=\"material-symbols-outlined text-on-primary\" style=\"font-variation-settings: 'FILL' 1;\">bedtime</span>\n</div>\n</div>\n<!-- Day 2: Shift -->\n<div class=\"flex items-center gap-6\">\n<div class=\"w-12 flex flex-col items-center\">\n<span class=\"text-[10px] font-bold uppercase tracking-tighter text-on-surface/40\">Tue</span>\n<span class=\"text-xl font-bold font-headline text-on-surface\">25</span>\n</div>\n<div class=\"flex-1 h-20 bg-primary/90 rounded-xl p-5 flex justify-between items-center shadow-lg shadow-primary/10\">\n<div class=\"space-y-1\">\n<span class=\"text-[10px] font-bold uppercase tracking-widest text-on-primary/70 block\">Shift Duration</span>\n<span class=\"text-lg font-bold font-headline text-on-primary\">19:00 — 07:00</span>\n</div>\n<span class=\"material-symbols-outlined text-on-primary\" style=\"font-variation-settings: 'FILL' 1;\">bedtime</span>\n</div>\n</div>\n<!-- Day 3: Off -->\n<div class=\"flex items-center gap-6\">\n<div class=\"w-12 flex flex-col items-center\">\n<span class=\"text-[10px] font-bold uppercase tracking-tighter text-on-surface/40\">Wed</span>\n<span class=\"text-xl font-bold font-headline text-on-surface\">26</span>\n</div>\n<div class=\"flex-1 h-20 bg-surface-container-low rounded-xl p-5 flex justify-between items-center border border-outline-variant/5\">\n<span class=\"text-lg font-bold font-headline text-on-surface/30 italic\">Off</span>\n<span class=\"material-symbols-outlined text-on-surface/10\">sunny</span>\n</div>\n</div>\n<!-- Day 4: Off -->\n<div class=\"flex items-center gap-6\">\n<div class=\"w-12 flex flex-col items-center\">\n<span class=\"text-[10px] font-bold uppercase tracking-tighter text-on-surface/40\">Thu</span>\n<span class=\"text-xl font-bold font-headline text-on-surface\">27</span>\n</div>\n<div class=\"flex-1 h-20 bg-surface-container-low rounded-xl p-5 flex justify-between items-center border border-outline-variant/5\">\n<span class=\"text-lg font-bold font-headline text-on-surface/30 italic\">Off</span>\n<span class=\"material-symbols-outlined text-on-surface/10\">sunny</span>\n</div>\n</div>\n<!-- Day 5: Shift -->\n<div class=\"flex items-center gap-6\">\n<div class=\"w-12 flex flex-col items-center\">\n<span class=\"text-[10px] font-bold uppercase tracking-tighter text-on-surface/40\">Fri</span>\n<span class=\"text-xl font-bold font-headline text-on-surface\">28</span>\n</div>\n<div class=\"flex-1 h-20 bg-primary/90 rounded-xl p-5 flex justify-between items-center shadow-lg shadow-primary/10\">\n<div class=\"space-y-1\">\n<span class=\"text-[10px] font-bold uppercase tracking-widest text-on-primary/70 block\">Shift Duration</span>\n<span class=\"text-lg font-bo