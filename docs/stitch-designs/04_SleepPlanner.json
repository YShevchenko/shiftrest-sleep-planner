{"screenId":"a4b5a9de4bd946549dac375651204826","projectId":"2689100580676332260","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Sleep Planner - The Circadian Cocoon</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    colors: {\n                        \"tertiary-container\": \"#df7306\",\n                        \"surface-container-lowest\": \"#0c0e12\",\n                        \"on-tertiary-container\": \"#451f00\",\n                        \"on-primary-fixed-variant\": \"#004591\",\n                        \"tertiary-fixed\": \"#ffdcc6\",\n                        \"secondary-fixed\": \"#d4e3ff\",\n                        \"on-tertiary-fixed-variant\": \"#713700\",\n                        \"tertiary-fixed-dim\": \"#ffb784\",\n                        \"on-secondary-fixed-variant\": \"#354863\",\n                        \"secondary\": \"#b4c8e9\",\n                        \"on-secondary-fixed\": \"#061c36\",\n                        \"tertiary\": \"#ffb784\",\n                        \"outline-variant\": \"#414754\",\n                        \"on-primary-container\": \"#00285a\",\n                        \"secondary-fixed-dim\": \"#b4c8e9\",\n                        \"on-background\": \"#e2e2e8\",\n                        \"inverse-on-surface\": \"#2f3035\",\n                        \"surface-bright\": \"#37393e\",\n                        \"on-tertiary-fixed\": \"#301400\",\n                        \"error-container\": \"#93000a\",\n                        \"on-surface\": \"#e2e2e8\",\n                        \"surface-variant\": \"#333539\",\n                        \"error\": \"#ffb4ab\",\n                        \"on-error-container\": \"#ffdad6\",\n                        \"primary-container\": \"#468fff\",\n                        \"on-tertiary\": \"#502500\",\n                        \"surface-tint\": \"#acc7ff\",\n                        \"surface-container\": \"#1e2024\",\n                        \"primary\": \"#acc7ff\",\n                        \"background\": \"#111317\",\n                        \"surface-container-low\": \"#1a1c20\",\n                        \"primary-fixed-dim\": \"#acc7ff\",\n                        \"on-primary-fixed\": \"#001a40\",\n                        \"on-primary\": \"#002f67\",\n                        \"outline\": \"#8b919f\",\n                        \"surface\": \"#111317\",\n                        \"primary-fixed\": \"#d7e2ff\",\n                        \"on-secondary-container\": \"#a6b9da\",\n                        \"on-error\": \"#690005\",\n                        \"inverse-primary\": \"#005cbd\",\n                        \"surface-dim\": \"#111317\",\n                        \"surface-container-highest\": \"#333539\",\n                        \"on-surface-variant\": \"#c1c6d6\",\n                        \"inverse-surface\": \"#e2e2e8\",\n                        \"on-secondary\": \"#1d314c\",\n                        \"surface-container-high\": \"#282a2e\",\n                        \"secondary-container\": \"#374a66\"\n                    },\n                    fontFamily: {\n                        \"headline\": [\"Manrope\"],\n                        \"body\": [\"Inter\"],\n                        \"label\": [\"Inter\"]\n                    },\n                    borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"1.5rem\", \"full\": \"9999px\"},\n                },\n            },\n        }\n    </script>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .sleep-gradient {\n            background: linear-gradient(135deg, #acc7ff 0%, #468fff 100%);\n        }\n        .glass-panel {\n            background-color: rgba(55, 57, 62, 0.6);\n            backdrop-filter: blur(24px);\n        }\n        body {\n            background-color: #111317;\n            color: #e2e2e8;\n            -webkit-font-smoothing: antialiased;\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"font-body selection:bg-primary/30\">\n<!-- TopAppBar Shell -->\n<nav class=\"w-full top-0 sticky z-50 bg-[#111317] dark:bg-[#111317] flex items-center justify-between px-6 py-4\">\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-[#acc7ff] cursor-pointer hover:bg-[#37393e]/60 transition-colors p-2 rounded-full active:scale-95\">menu</span>\n<span class=\"font-['Manrope'] headline-lg tracking-tight text-xl font-bold text-[#e2e2e8]\">Sleep Planner</span>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[#e2e2e8] p-2 hover:bg-[#37393e]/60 rounded-full transition-colors cursor-pointer active:scale-95\">notifications</span>\n</div>\n</nav>\n<main class=\"px-6 pb-40 pt-4 max-w-md mx-auto\">\n<!-- Editorial Header -->\n<header class=\"mb-12\">\n<p class=\"text-primary font-label text-[0.75rem] font-medium tracking-[0.1rem] uppercase mb-2\">Upcoming Schedule</p>\n<h1 class=\"font-headline text-[2rem] leading-tight font-extrabold text-on-surface\">Based on your next shift...</h1>\n</header>\n<!-- Primary Recommendation Card (The Cocoon) -->\n<section class=\"relative group\">\n<div class=\"absolute -inset-1 bg-gradient-to-r from-primary/20 to-tertiary/10 rounded-xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200\"></div>\n<div class=\"relative bg-surface-container-high rounded-xl p-8 flex flex-col items-center justify-center min-h-[320px] overflow-hidden\">\n<!-- Visual Background Accent -->\n<div class=\"absolute -top-24 -right-24 w-64 h-64 bg-primary/5 rounded-full blur-3xl\"></div>\n<span class=\"material-symbols-outlined text-primary text-5xl mb-6\" style=\"font-variation-settings: 'FILL' 1;\">bedtime</span>\n<h2 class=\"text-on-surface-variant font-label text-[0.75rem] font-medium tracking-widest uppercase mb-4\">Recommended</h2>\n<div class=\"text-center mb-8\">\n<p class=\"font-headline text-4xl font-extrabold text-on-surface tracking-tighter\">Sleep Window</p>\n<div class=\"flex items-baseline justify-center gap-2 mt-2\">\n<span class=\"font-headline text-5xl font-extrabold text-primary\">09:00</span>\n<span class=\"text-outline text-xl\">—</span>\n<span class=\"font-headline text-5xl font-extrabold text-primary\">16:30</span>\n</div>\n</div>\n<div class=\"flex items-center gap-3 py-2 px-4 bg-surface-container-highest rounded-full\">\n<span class=\"material-symbols-outlined text-tertiary text-sm\">schedule</span>\n<span class=\"text-on-surface font-label text-[0.75rem]\">Duration: 7h 30m</span>\n</div>\n</div>\n</section>\n<!-- Main CTA -->\n<div class=\"mt-8\">\n<button class=\"w-full py-5 sleep-gradient text-on-primary-container font-headline text-lg font-bold rounded-full active:scale-95 transition-transform duration-100 flex items-center justify-center gap-3\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">alarm_add</span>\n                Accept &amp; Set Alarm\n            </button>\n</div>\n<!-- Timeline Section -->\n<section class=\"mt-16\">\n<div class=\"flex justify-between items-end mb-6\">\n<div>\n<h3 class=\"font-headline text-xl font-bold text-on-surface\">Timeline View</h3>\n<p class=\"text-on-surface-variant text-[0.75rem]\">Your circadian distribution</p>\n</div>\n<span class=\"material-symbols-outlined text-outline-variant hover:text-primary cursor-pointer transition-colors\">info</span>\n</div>\n<!-- Gantt-style Timeline Bar -->\n<div class=\"relative w-full h-24 bg-surface-container-low rounded-xl p-4 flex flex-col justify-between overflow-hidden\">\n<!-- Timeline Rulers -->\n<div class=\"flex justify-between px-2\">\n<span class=\"text-[0.6rem] text-outline-variant\">00:00</span>\n<span class=\"text-[0.6rem] text-outline-variant\">06:00</span>\n<span class=\"text-[0.6rem] text-outline-variant\">12:00</span>\n<span class=\"text-[0.6rem] text-outline-variant\">18:00</span>\n<span class=\"text-[0.6rem] text-outline-variant\">23:59</span>\n</div>\n<!-- The Visualization Bar -->\n<div class=\"relative w-full h-8 bg-surface-container-highest rounded-full overflow-hidden flex\">\n<!-- Pre-sleep Activity -->\n<div class=\"h-full w-[25%]\" title=\"Activity\"></div>\n<!-- Sleep Block (09:00 - 16:30 roughly 30% of bar starting at 37%) -->\n<div class=\"h-full w-[31%] bg-primary/40 flex items-center justify-center relative group\" title=\"Sleep Block\">\n<div class=\"absolute inset-0 bg-primary/20 animate-pulse\"></div>\n<span class=\"material-symbols-outlined text-primary text-xs relative z-10\" style=\"font-variation-settings: 'FILL' 1;\">bedtime</span>\n</div>\n<!-- Post-sleep / Transition -->\n<div class=\"h-full w-[14%]\" title=\"Transition\"></div>\n<!-- Upcoming Shift (e.g., 20:00 onwards) -->\n<div class=\"h-full w-[30%] bg-tertiary/30 flex items-center justify-center\" title=\"Shift Block\">\n<span class=\"material-symbols-outlined text-tertiary text-xs\">work</span>\n</div>\n</div>\n<!-- Labels -->\n<div class=\"flex justify-between px-1\">\n<div class=\"flex items-center gap-1\">\n<div class=\"w-1.5 h-1.5 rounded-full bg-primary\"></div>\n<span class=\"text-[0.65rem] text-on-surface-variant\">Sleep</span>\n</div>\n<div class=\"flex items-center gap-1\">\n<div class=\"w-1.5 h-1.5 rounded-full bg-tertiary\"></div>\n<span class=\"text-[0.65rem] text-on-surface-variant\">Shift</span>\n</div>\n<div class=\"flex items-center gap-1\">\n<span class=\"text-[0.65rem] font-bold text-on-surface\">Now: 07:15</span>\n</div>\n</div>\n<!-- Current Time Marker -->\n<div class=\"absolute top-0 bottom-0 w-[2px] bg-on-background left-[30%] z-20\">\n<div class=\"absolute -top-1 -left-1 w-2.5 h-2.5 rounded-full bg-on-background shadow-lg shadow-white/20\"></div>\n</div>\n</div>\n</section>\n</main>\n<!-- BottomNavBar Shell -->\n<nav class=\"fixed bottom-0 left-0 w-full flex justify-around items-center px-4 pb-6 pt-3 bg-[#37393e]/60 dark:bg-[#37393e]/60 backdrop-blur-xl z-50 rounded-t-[1.5rem] shadow-[0_-4px_32px_rgba(226,226,232,0.06)]\">\n<!-- Focus Tab (Active based on Sleep Planner Intent) -->\n<a class=\"flex flex-col items-center justify-center bg-[#acc7ff]/10 text-[#acc7ff] rounded-full px-4 py-1 scale-110 transition-transform duration-300 ease-out\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">bedtime</span>\n<span class=\"font-['Inter'] text-[0.75rem] font-medium\">Focus</span>\n</a>\n<!-- Rhythm Tab -->\n<a class=\"flex flex-col items-center justify-center text-[#e2e2e8]/60 hover:text-[#e2e2e8] transition-colors\" href=\"#\">\n<span class=\"material-symbols-outlined\">timer</span>\n<span class=\"font-['Inter'] text-[0.75rem] font-medium\">Rhythm</span>\n</a>\n<!-- Insights Tab -->\n<a class=\"flex flex-col items-center justify-center text-[#e2e2e8]/60 hover:text-[#e2e2e8] transition-colors\" href=\"#\">\n<span class=\"material-symbols-outlined\">query_stats</span>\n<span class=\"font-['Inter'] text-[0.75rem] font-medium\">Insights</span>\n</a>\n<!-- Profile Tab -->\n<a class=\"flex flex-col items-center justify-center text-[#e2e2e8]/60 hover:text-[#e2e2e8] transition-colors\" href=\"#\">\n<span class=\"material-symbols-outlined\">person</span>\n<span class=\"font-['Inter'] text-[0.75rem] font-medium\">Profile</span>\n</a>\n</nav>\n</body></html>"}
