{"screenId":"78b0aa2cfc514e71a5ae4602a858d13d","projectId":"2689100580676332260","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Add Shift - Nocturnal Sanctuary</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n    tailwind.config = {\n      darkMode: \"class\",\n      theme: {\n        extend: {\n          colors: {\n            \"on-error-container\": \"#ffdad6\",\n            \"surface-container-high\": \"#282a2e\",\n            \"error-container\": \"#93000a\",\n            \"surface-container-highest\": \"#333539\",\n            \"secondary-fixed-dim\": \"#b4c8e9\",\n            \"on-tertiary-fixed\": \"#301400\",\n            \"on-error\": \"#690005\",\n            \"tertiary\": \"#ffb784\",\n            \"surface-variant\": \"#333539\",\n            \"on-tertiary-container\": \"#451f00\",\n            \"inverse-surface\": \"#e2e2e8\",\n            \"outline-variant\": \"#414754\",\n            \"error\": \"#ffb4ab\",\n            \"on-primary\": \"#002f67\",\n            \"on-primary-container\": \"#00285a\",\n            \"surface-container-lowest\": \"#0c0e12\",\n            \"on-secondary\": \"#1d314c\",\n            \"inverse-primary\": \"#005cbd\",\n            \"secondary\": \"#b4c8e9\",\n            \"inverse-on-surface\": \"#2f3035\",\n            \"surface\": \"#111317\",\n            \"secondary-container\": \"#374a66\",\n            \"on-primary-fixed\": \"#001a40\",\n            \"primary-fixed-dim\": \"#acc7ff\",\n            \"surface-tint\": \"#acc7ff\",\n            \"on-secondary-fixed\": \"#061c36\",\n            \"primary-container\": \"#468fff\",\n            \"tertiary-fixed-dim\": \"#ffb784\",\n            \"on-tertiary\": \"#502500\",\n            \"tertiary-container\": \"#df7306\",\n            \"primary-fixed\": \"#d7e2ff\",\n            \"on-tertiary-fixed-variant\": \"#713700\",\n            \"surface-dim\": \"#111317\",\n            \"on-primary-fixed-variant\": \"#004591\",\n            \"on-secondary-container\": \"#a6b9da\",\n            \"on-surface\": \"#e2e2e8\",\n            \"secondary-fixed\": \"#d4e3ff\",\n            \"on-background\": \"#e2e2e8\",\n            \"background\": \"#111317\",\n            \"surface-container\": \"#1e2024\",\n            \"outline\": \"#8b919f\",\n            \"tertiary-fixed\": \"#ffdcc6\",\n            \"primary\": \"#acc7ff\",\n            \"on-surface-variant\": \"#c1c6d6\",\n            \"surface-bright\": \"#37393e\",\n            \"surface-container-low\": \"#1a1c20\",\n            \"on-secondary-fixed-variant\": \"#354863\"\n          },\n          fontFamily: {\n            \"headline\": [\"Manrope\"],\n            \"body\": [\"Inter\"],\n            \"label\": [\"Inter\"]\n          },\n          borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n        },\n      },\n    }\n  </script>\n<style>\n    .material-symbols-outlined {\n      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n    }\n    input[type=\"range\"]::-webkit-slider-thumb {\n      -webkit-appearance: none;\n      height: 24px;\n      width: 24px;\n      border-radius: 50%;\n      background: #ffb784;\n      cursor: pointer;\n      border: 4px solid #111317;\n      box-shadow: 0 0 10px rgba(255, 183, 132, 0.3);\n    }\n    .no-scrollbar::-webkit-scrollbar {\n      display: none;\n    }\n    .no-scrollbar {\n      -ms-overflow-style: none;\n      scrollbar-width: none;\n    }\n  </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-background text-on-surface font-body selection:bg-primary/30 antialiased\">\n<!-- Main Modal Container -->\n<div class=\"relative min-h-screen flex flex-col max-w-md mx-auto bg-surface overflow-hidden\">\n<!-- TopAppBar Template -->\n<header class=\"flex items-center px-6 py-4 w-full justify-between bg-[#111317] sticky top-0 z-10\">\n<div class=\"flex items-center gap-4\">\n<button class=\"hover:opacity-80 transition-opacity scale-95 duration-200 text-[#acc7ff]\">\n<span class=\"material-symbols-outlined\">close</span>\n</button>\n<h1 class=\"font-['Manrope'] font-bold text-2xl tracking-tight text-[#acc7ff]\">Add Shift</h1>\n</div>\n<div class=\"text-[#e2e2e8] font-bold text-xl\">\n<!-- Logo placeholder -->\n</div>\n</header>\n<!-- Scrollable Content Area -->\n<main class=\"flex-1 px-8 pt-6 pb-32 no-scrollbar overflow-y-auto\">\n<!-- Editorial Date Header -->\n<div class=\"mb-12\">\n<span class=\"font-label text-xs uppercase tracking-[0.2rem] text-primary mb-2 block\">New Entry</span>\n<h2 class=\"font-headline text-4xl font-extrabold tracking-tighter leading-none text-on-surface\">Tonight's Rhythm.</h2>\n</div>\n<!-- Time Input Section -->\n<div class=\"space-y-12\">\n<div class=\"grid grid-cols-2 gap-8\">\n<div class=\"relative\">\n<label class=\"font-label text-[10px] uppercase tracking-widest text-on-surface-variant/60 mb-3 block\">Start Time</label>\n<input class=\"w-full bg-surface-container-lowest border-none p-0 text-3xl font-headline font-bold text-on-surface focus:ring-0 placeholder-on-surface-variant/20\" type=\"text\" value=\"22:00\"/>\n<div class=\"absolute bottom-[-8px] left-0 w-full h-[2px] bg-primary\"></div>\n</div>\n<div class=\"relative\">\n<label class=\"font-label text-[10px] uppercase tracking-widest text-on-surface-variant/60 mb-3 block\">End Time</label>\n<input class=\"w-full bg-surface-container-lowest border-none p-0 text-3xl font-headline font-bold text-on-surface focus:ring-0 placeholder-on-surface-variant/20\" type=\"text\" value=\"06:00\"/>\n<div class=\"absolute bottom-[-8px] left-0 w-full h-[2px] bg-outline-variant/30\"></div>\n</div>\n</div>\n<!-- Shift Type (Segmented Control / Large Buttons) -->\n<section>\n<label class=\"font-label text-[10px] uppercase tracking-widest text-on-surface-variant/60 mb-4 block\">Shift Category</label>\n<div class=\"grid grid-cols-3 gap-3\">\n<button class=\"bg-surface-container-high text-on-surface rounded-xl py-5 px-2 flex flex-col items-center justify-center gap-2 hover:bg-surface-bright transition-colors group\">\n<span class=\"material-symbols-outlined text-primary group-hover:scale-110 transition-transform\">light_mode</span>\n<span class=\"font-label text-xs font-semibold\">Day</span>\n</button>\n<button class=\"bg-primary text-on-primary rounded-xl py-5 px-2 flex flex-col items-center justify-center gap-2 hover:opacity-90 transition-opacity\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">bedtime</span>\n<span class=\"font-label text-xs font-semibold\">Night</span>\n</button>\n<button class=\"bg-surface-container-high text-on-surface rounded-xl py-5 px-2 flex flex-col items-center justify-center gap-2 hover:bg-surface-bright transition-colors group\">\n<span class=\"material-symbols-outlined text-tertiary group-hover:scale-110 transition-transform\">notifications_active</span>\n<span class=\"font-label text-xs font-semibold\">On-Call</span>\n</button>\n</div>\n</section>\n<!-- Commute Slider -->\n<section>\n<div class=\"flex justify-between items-end mb-6\">\n<div>\n<label class=\"font-label text-[10px] uppercase tracking-widest text-on-surface-variant/60 mb-1 block\">Commute Time</label>\n<h3 class=\"font-headline text-2xl font-bold\">30 <span class=\"text-sm font-normal text-on-surface-variant\">mins</span></h3>\n</div>\n<span class=\"material-symbols-outlined text-tertiary text-3xl\">directions_car</span>\n</div>\n<div class=\"relative h-12 flex items-center\">\n<div class=\"absolute w-full h-1.5 bg-surface-container-highest rounded-full\"></div>\n<div class=\"absolute w-1/2 h-1.5 bg-primary-fixed-dim rounded-full\"></div>\n<input class=\"absolute w-full appearance-none bg-transparent cursor-pointer z-10 focus:outline-none\" max=\"120\" min=\"0\" type=\"range\" value=\"30\"/>\n</div>\n<div class=\"flex justify-between mt-2 font-label text-[9px] text-on-surface-variant/40 tracking-wider\">\n<span>0 MIN</span>\n<span>120 MIN</span>\n</div>\n</section>\n<!-- Visual Context Card (Atmospheric Design) -->\n<div class=\"bg-surface-container-low rounded-xl p-6 flex items-center gap-6 overflow-hidden relative\">\n<div class=\"flex-1 relative z-10\">\n<p class=\"font-headline text-lg font-bold leading-tight\">Syncing with Sunset</p>\n<p class=\"font-body text-xs text-on-surface-variant mt-1\">Your shift starts exactly 2 hours after local sunset. Maintain melatonin hygiene.</p>\n</div>\n<div class=\"w-16 h-16 rounded-full bg-gradient-to-tr from-tertiary to-tertiary-container blur-xl opacity-20 absolute -right-4 -bottom-4\"></div>\n<span class=\"material-symbols-outlined text-4xl text-tertiary opacity-80\" style=\"font-variation-settings: 'FILL' 1;\">routine</span>\n</div>\n</div>\n</main>\n<!-- Bottom Action Area -->\n<div class=\"fixed bottom-0 left-0 w-full max-w-md mx-auto p-6 bg-gradient-to-t from-surface via-surface to-transparent\">\n<button class=\"w-full py-5 rounded-full bg-gradient-to-br from-[#acc7ff] to-[#468fff] text-[#002f67] font-headline font-extrabold text-lg tracking-tight active:scale-95 transition-transform shadow-[0_12px_24px_rgba(172,199,255,0.2)]\">\n        Save Shift\n      </button>\n</div>\n</div>\n<!-- Decorative Grain Layer -->\n<div class=\"fixed inset-0 pointer-events-none opacity-[0.03] mix-blend-overlay\">\n<div class=\"absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] bg-repeat\"></div>\n</div>\n</body></html>"}
