{"screenId":"bdb6d752d26e47b284a2d8f67956717e","projectId":"2689100580676332260","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Dark Room - Active Sleep Mode</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            colors: {\n              \"secondary-fixed\": \"#d4e3ff\",\n              \"primary-container\": \"#468fff\",\n              \"on-secondary-fixed-variant\": \"#354863\",\n              \"outline\": \"#8b919f\",\n              \"on-primary\": \"#002f67\",\n              \"inverse-on-surface\": \"#2f3035\",\n              \"tertiary-fixed\": \"#ffdcc6\",\n              \"primary-fixed\": \"#d7e2ff\",\n              \"primary-fixed-dim\": \"#acc7ff\",\n              \"on-surface\": \"#e2e2e8\",\n              \"error-container\": \"#93000a\",\n              \"surface-container-highest\": \"#333539\",\n              \"inverse-primary\": \"#005cbd\",\n              \"tertiary-container\": \"#df7306\",\n              \"surface-bright\": \"#37393e\",\n              \"on-primary-container\": \"#00285a\",\n              \"secondary-container\": \"#374a66\",\n              \"on-background\": \"#e2e2e8\",\n              \"tertiary-fixed-dim\": \"#ffb784\",\n              \"secondary\": \"#b4c8e9\",\n              \"inverse-surface\": \"#e2e2e8\",\n              \"on-tertiary-fixed\": \"#301400\",\n              \"on-secondary-container\": \"#a6b9da\",\n              \"on-tertiary-fixed-variant\": \"#713700\",\n              \"on-primary-fixed\": \"#001a40\",\n              \"tertiary\": \"#ffb784\",\n              \"primary\": \"#acc7ff\",\n              \"on-tertiary\": \"#502500\",\n              \"on-error\": \"#690005\",\n              \"on-secondary\": \"#1d314c\",\n              \"surface-tint\": \"#acc7ff\",\n              \"on-secondary-fixed\": \"#061c36\",\n              \"error\": \"#ffb4ab\",\n              \"surface-container-high\": \"#282a2e\",\n              \"surface-container\": \"#1e2024\",\n              \"on-surface-variant\": \"#c1c6d6\",\n              \"surface-dim\": \"#111317\",\n              \"surface-container-lowest\": \"#0c0e12\",\n              \"surface-container-low\": \"#1a1c20\",\n              \"secondary-fixed-dim\": \"#b4c8e9\",\n              \"outline-variant\": \"#414754\",\n              \"surface-variant\": \"#333539\",\n              \"on-tertiary-container\": \"#451f00\",\n              \"on-error-container\": \"#ffdad6\",\n              \"surface\": \"#111317\",\n              \"on-primary-fixed-variant\": \"#004591\",\n              \"background\": \"#111317\"\n            },\n            fontFamily: {\n              \"headline\": [\"Manrope\"],\n              \"body\": [\"Inter\"],\n              \"label\": [\"Inter\"]\n            },\n            borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n          },\n        },\n      }\n    </script>\n<style>\n        body {\n            background-color: #000000;\n            cursor: none; /* Immersive sleep mode feel */\n        }\n        .dim-red-glow {\n            box-shadow: 0 0 20px rgba(127, 29, 29, 0.2);\n        }\n        input[type='range']::-webkit-slider-runnable-track {\n            background: #450a0a;\n            border-radius: 9999px;\n            height: 4px;\n        }\n        input[type='range']::-webkit-slider-thumb {\n            -webkit-appearance: none;\n            appearance: none;\n            margin-top: -6px;\n            background-color: #991b1b;\n            border-radius: 9999px;\n            height: 16px;\n            width: 16px;\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 200, 'GRAD' 0, 'opsz' 48;\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"flex flex-col min-h-screen text-red-900 select-none overflow-hidden\">\n<!-- Top Navigation Anchor (As per Shared Components JSON) -->\n<header class=\"fixed top-0 w-full flex justify-between items-center px-6 py-4 opacity-10 hover:opacity-100 transition-opacity duration-700 bg-black z-50\">\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-red-950 hover:text-red-500 transition-colors cursor-pointer\" data-icon=\"close\">close</span>\n<h1 class=\"font-manrope text-lg uppercase tracking-widest text-red-900\">Dark Room</h1>\n</div>\n<div class=\"text-red-950 font-bold opacity-30 text-sm tracking-[0.2em] uppercase\">\n            Nocturnal\n        </div>\n</header>\n<!-- Main Content Canvas -->\n<main class=\"flex-grow flex flex-col items-center justify-center px-8 relative\">\n<!-- Sleep Visualization Subtle Mesh -->\n<div class=\"absolute inset-0 z-0 opacity-5 pointer-events-none\" style=\"background: radial-gradient(circle at 50% 50%, #7f1d1d 0%, transparent 70%);\">\n</div>\n<!-- Clock Face -->\n<section class=\"text-center z-10 space-y-4\">\n<div class=\"font-headline font-extrabold text-[12rem] md:text-[18rem] leading-none tracking-tighter opacity-40 select-none\">\n                14:30\n            </div>\n<div class=\"flex items-center justify-center gap-3 font-body text-red-950 tracking-[0.15em] uppercase text-sm opacity-60\">\n<span class=\"material-symbols-outlined text-base\" data-icon=\"alarm\">alarm</span>\n                Alarm set for 16:30\n            </div>\n</section>\n<!-- Noise Controls Module -->\n<section class=\"mt-24 flex flex-col items-center gap-12 z-10\">\n<div class=\"flex flex-col items-center gap-6\">\n<button class=\"w-24 h-24 rounded-full flex items-center justify-center bg-black border border-red-950 text-red-900 hover:border-red-900 transition-all duration-500 group\">\n<span class=\"material-symbols-outlined text-4xl group-active:scale-95\" data-icon=\"waves\" style=\"font-variation-settings: 'FILL' 1;\">waves</span>\n</button>\n<div class=\"text-center\">\n<p class=\"font-label text-xs uppercase tracking-widest text-red-950 mb-4\">White Noise</p>\n<div class=\"w-48 px-2\">\n<input class=\"w-full h-1 bg-transparent appearance-none cursor-pointer\" max=\"100\" min=\"0\" type=\"range\" value=\"30\"/>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- Interactive Wake Gesture Area -->\n<footer class=\"p-8 w-full max-w-lg mx-auto z-20\">\n<div class=\"relative h-20 bg-black rounded-full border border-red-950/30 flex items-center px-2 group transition-all duration-700 hover:border-red-900/40\">\n<!-- Glide Track -->\n<div class=\"absolute inset-0 bg-gradient-to-r from-red-950/10 to-transparent rounded-full opacity-50\"></div>\n<!-- Draggable Handle (Visual Only) -->\n<div class=\"h-16 w-16 bg-red-950/20 rounded-full flex items-center justify-center text-red-800 shadow-inner z-10\">\n<span class=\"material-symbols-outlined\" data-icon=\"keyboard_double_arrow_right\">keyboard_double_arrow_right</span>\n</div>\n<!-- Instruction Text -->\n<div class=\"flex-grow text-center pr-12\">\n<span class=\"font-label text-xs uppercase tracking-[0.25em] text-red-950 font-semibold select-none group-hover:text-red-900 transition-colors\">\n                    Slide to Wake Up\n                </span>\n</div>\n<!-- Subtle Glow Pulse -->\n<div class=\"absolute inset-0 rounded-full dim-red-glow pointer-events-none opacity-20\"></div>\n</div>\n</footer>\n<!-- Bottom Decorative Visual Buffer -->\n<div class=\"h-4 w-full bg-gradient-to-t from-red-950/5 to-transparent\"></div>\n</body></html>"}
