{"screenId":"a3393e8afd05484485454352a30335fa","projectId":"2689100580676332260","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Manrope:wght@700;800&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            colors: {\n              \"outline-variant\": \"#414754\",\n              \"on-surface\": \"#e2e2e8\",\n              \"surface-container-highest\": \"#333539\",\n              \"on-surface-variant\": \"#c1c6d6\",\n              \"primary-container\": \"#468fff\",\n              \"surface-variant\": \"#333539\",\n              \"on-error\": \"#690005\",\n              \"surface-bright\": \"#37393e\",\n              \"on-primary-fixed-variant\": \"#004591\",\n              \"inverse-on-surface\": \"#2f3035\",\n              \"secondary-fixed\": \"#d4e3ff\",\n              \"on-tertiary-fixed\": \"#301400\",\n              \"surface-dim\": \"#111317\",\n              \"on-secondary-container\": \"#a6b9da\",\n              \"error-container\": \"#93000a\",\n              \"secondary\": \"#b4c8e9\",\n              \"tertiary\": \"#ffb784\",\n              \"surface-container-low\": \"#1a1c20\",\n              \"surface-tint\": \"#acc7ff\",\n              \"on-primary-container\": \"#00285a\",\n              \"on-error-container\": \"#ffdad6\",\n              \"error\": \"#ffb4ab\",\n              \"primary\": \"#acc7ff\",\n              \"on-tertiary-container\": \"#451f00\",\n              \"surface\": \"#111317\",\n              \"inverse-primary\": \"#005cbd\",\n              \"surface-container\": \"#1e2024\",\n              \"surface-container-high\": \"#282a2e\",\n              \"primary-fixed-dim\": \"#acc7ff\",\n              \"on-tertiary\": \"#502500\",\n              \"outline\": \"#8b919f\",\n              \"on-secondary\": \"#1d314c\",\n              \"inverse-surface\": \"#e2e2e8\",\n              \"on-secondary-fixed\": \"#061c36\",\n              \"on-background\": \"#e2e2e8\",\n              \"surface-container-lowest\": \"#0c0e12\",\n              \"primary-fixed\": \"#d7e2ff\",\n              \"secondary-fixed-dim\": \"#b4c8e9\",\n              \"on-primary\": \"#002f67\",\n              \"secondary-container\": \"#374a66\",\n              \"on-primary-fixed\": \"#001a40\",\n              \"tertiary-fixed-dim\": \"#ffb784\",\n              \"on-tertiary-fixed-variant\": \"#713700\",\n              \"background\": \"#111317\",\n              \"tertiary-container\": \"#df7306\",\n              \"on-secondary-fixed-variant\": \"#354863\",\n              \"tertiary-fixed\": \"#ffdcc6\"\n            },\n            fontFamily: {\n              \"headline\": [\"Manrope\"],\n              \"body\": [\"Inter\"],\n              \"label\": [\"Inter\"]\n            },\n            borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n          },\n        },\n      }\n    </script>\n<style>\n      .material-symbols-outlined {\n        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n      }\n      body {\n        background-color: #111317;\n        color: #e2e2e8;\n      }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"font-body selection:bg-primary selection:text-on-primary\">\n<div class=\"min-h-screen flex flex-col relative overflow-hidden\">\n<!-- Atmospheric Background Glow -->\n<div class=\"absolute top-[-10%] right-[-20%] w-96 h-96 bg-primary/10 blur-[120px] rounded-full\"></div>\n<div class=\"absolute bottom-[-5%] left-[-10%] w-80 h-80 bg-tertiary/5 blur-[100px] rounded-full\"></div>\n<!-- Top App Bar (Suppressed Navigation but maintaining Brand Identity) -->\n<header class=\"flex justify-between items-center px-6 py-8 w-full z-10\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary text-3xl\">nights_stay</span>\n<span class=\"font-headline text-2xl font-bold text-on-surface tracking-tighter\">Nocturnal</span>\n</div>\n<div class=\"text-on-surface-variant font-label text-xs tracking-widest uppercase opacity-60\">Step 1 of 3</div>\n</header>\n<!-- Main Content Canvas -->\n<main class=\"flex-1 flex flex-col px-8 pt-12 pb-24 z-10 relative\">\n<!-- Hero Imagery / Abstract Visual -->\n<div class=\"mb-12 relative h-48 w-full\">\n<div class=\"absolute inset-0 bg-surface-container-low rounded-xl overflow-hidden shadow-2xl\">\n<img alt=\"Abstract visualization of rhythmic light patterns\" class=\"w-full h-full object-cover opacity-40 mix-blend-luminosity\" data-alt=\"Abstract aesthetic shot of soft neon blue light flowing through dark glass textures with deep shadows and organic curves\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuC6s-l-vb47XNyszewzU41inOIrNVyeKlqJ6pkYPCPJiP1IFwXZaXtojXD-dLkXM92fO94XGSLbMaHiR07I9HUpEdz-0lbAQT5W1y5GMtjBaN0jTHvFd-T0ORjCsIjKdDhkD9oKNPQKpnwtspqnmF1TT2ZS9vwOEUfdR21E2i5M7K3VjKMqe_n2E51EsfnvJs-op-dwLGSvns-yG3FbDFTu7vYJRrWwhRLH34W6RM6irOwpcqWy4pRDX-dazohOrimd5q-puIYpxx0\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-surface-dim via-transparent to-transparent\"></div>\n</div>\n<!-- Floating Decorative Element -->\n<div class=\"absolute -bottom-4 -right-4 w-24 h-24 bg-surface-bright/60 backdrop-blur-2xl rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary text-4xl\" data-weight=\"fill\" style=\"font-variation-settings: 'FILL' 1;\">bedtime</span>\n</div>\n</div>\n<!-- Value Proposition -->\n<div class=\"space-y-6 max-w-sm\">\n<h1 class=\"font-headline text-5xl font-extrabold text-on-surface leading-[1.1] tracking-tighter\">\n                    We do the sleep math for your shifts\n                </h1>\n<p class=\"font-body text-on-surface-variant text-lg leading-relaxed opacity-80\">\n                    Irregular hours don't have to mean irregular rest. We optimize your circadian rhythm based on your unique roster.\n                </p>\n</div>\n<!-- Dynamic Spacer for Layout Balance -->\n<div class=\"flex-1\"></div>\n<!-- Call to Action Section -->\n<div class=\"space-y-8 flex flex-col items-center\">\n<button class=\"w-full py-5 bg-gradient-to-br from-primary to-primary-container text-on-primary-container font-headline text-xl font-bold rounded-full transition-transform active:scale-95 shadow-lg shadow-primary/10\">\n                    Enter First Shift\n                </button>\n<div class=\"flex flex-col items-center gap-4\">\n<div class=\"flex items-center gap-2 px-4 py-2 bg-surface-container-low rounded-full\">\n<span class=\"material-symbols-outlined text-on-surface-variant text-sm\">shield</span>\n<span class=\"font-label text-xs text-on-surface-variant tracking-wide\">100% Private &amp; Offline</span>\n</div>\n<button class=\"text-on-surface-variant font-label text-sm uppercase tracking-[0.1rem] hover:text-white transition-colors\">\n                        Already have an account? Log In\n                    </button>\n</div>\n</div>\n</main>\n<!-- Footer / Bottom Anchor -->\n<footer class=\"pb-8 pt-4 px-8 text-center\">\n<p class=\"font-body text-[10px] text-outline tracking-widest leading-relaxed max-w-xs mx-auto\">\n                No data leaves this device. Your biological clock is your business.\n            </p>\n</footer>\n</div>\n</body></html>"}
