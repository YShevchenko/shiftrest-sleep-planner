{"screenId":"be87533d1ffe4c6087d9de8d06f9c447","projectId":"2689100580676332260","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"en\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Sleep History &amp; Settings</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    colors: {\n                        \"surface-bright\": \"#37393e\",\n                        \"primary\": \"#acc7ff\",\n                        \"outline\": \"#8b919f\",\n                        \"on-primary-fixed\": \"#001a40\",\n                        \"on-primary-container\": \"#00285a\",\n                        \"inverse-primary\": \"#005cbd\",\n                        \"tertiary-container\": \"#df7306\",\n                        \"surface-variant\": \"#333539\",\n                        \"on-tertiary-container\": \"#451f00\",\n                        \"secondary-fixed\": \"#d4e3ff\",\n                        \"on-primary\": \"#002f67\",\n                        \"surface-container-low\": \"#1a1c20\",\n                        \"on-surface-variant\": \"#c1c6d6\",\n                        \"surface\": \"#111317\",\n                        \"on-tertiary-fixed-variant\": \"#713700\",\n                        \"on-secondary-fixed-variant\": \"#354863\",\n                        \"on-background\": \"#e2e2e8\",\n                        \"tertiary-fixed-dim\": \"#ffb784\",\n                        \"secondary\": \"#b4c8e9\",\n                        \"on-tertiary\": \"#502500\",\n                        \"primary-fixed\": \"#d7e2ff\",\n                        \"on-secondary\": \"#1d314c\",\n                        \"tertiary-fixed\": \"#ffdcc6\",\n                        \"background\": \"#111317\",\n                        \"inverse-on-surface\": \"#2f3035\",\n                        \"primary-container\": \"#468fff\",\n                        \"secondary-fixed-dim\": \"#b4c8e9\",\n                        \"on-surface\": \"#e2e2e8\",\n                        \"on-error-container\": \"#ffdad6\",\n                        \"error-container\": \"#93000a\",\n                        \"surface-container\": \"#1e2024\",\n                        \"surface-container-lowest\": \"#0c0e12\",\n                        \"inverse-surface\": \"#e2e2e8\",\n                        \"surface-dim\": \"#111317\",\n                        \"secondary-container\": \"#374a66\",\n                        \"surface-container-highest\": \"#333539\",\n                        \"on-primary-fixed-variant\": \"#004591\",\n                        \"primary-fixed-dim\": \"#acc7ff\",\n                        \"on-secondary-fixed\": \"#061c36\",\n                        \"error\": \"#ffb4ab\",\n                        \"surface-tint\": \"#acc7ff\",\n                        \"on-tertiary-fixed\": \"#301400\",\n                        \"surface-container-high\": \"#282a2e\",\n                        \"on-error\": \"#690005\",\n                        \"tertiary\": \"#ffb784\",\n                        \"outline-variant\": \"#414754\",\n                        \"on-secondary-container\": \"#a6b9da\"\n                    },\n                    fontFamily: {\n                        \"headline\": [\"Manrope\"],\n                        \"body\": [\"Inter\"],\n                        \"label\": [\"Inter\"]\n                    },\n                    borderRadius: {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                },\n            },\n        }\n    </script>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        body {\n            background-color: #111317;\n            color: #e2e2e8;\n            -webkit-tap-highlight-color: transparent;\n        }\n        .hide-scrollbar::-webkit-scrollbar {\n            display: none;\n        }\n        .hide-scrollbar {\n            -ms-overflow-style: none;\n            scrollbar-width: none;\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"font-body selection:bg-primary-container selection:text-on-primary-container\">\n<!-- TopAppBar Shell -->\n<header class=\"w-full sticky top-0 z-50 bg-[#111317] dark:bg-[#111317] flex items-center justify-between px-6 py-4 w-full no-border space-y-6\">\n<div class=\"flex items-center space-x-4\">\n<button class=\"text-[#acc7ff] hover:opacity-80 transition-opacity scale-95 active:scale-90 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"arrow_back\">arrow_back</span>\n</button>\n<h1 class=\"font-['Manrope'] font-bold text-2xl tracking-tight text-[#e2e2e8]\">Profile &amp; History</h1>\n</div>\n<div class=\"flex items-center space-x-2\">\n<span class=\"font-['Manrope'] font-black text-[#e2e2e8]\">V.2</span>\n</div>\n</header>\n<main class=\"max-w-md mx-auto px-6 pt-4 pb-32\">\n<!-- Sleep History Section -->\n<section class=\"mb-12\">\n<div class=\"flex items-end justify-between mb-8\">\n<div>\n<p class=\"text-primary font-label text-[10px] tracking-widest uppercase mb-1\">Circadian Insights</p>\n<h2 class=\"font-headline font-extrabold text-3xl text-on-surface\">Sleep History</h2>\n</div>\n<div class=\"text-right\">\n<p class=\"text-on-surface-variant font-body text-xs\">Last 14 Days</p>\n</div>\n</div>\n<!-- Bento-style List Container -->\n<div class=\"space-y-6\">\n<!-- Legend -->\n<div class=\"flex items-center space-x-6 px-2\">\n<div class=\"flex items-center space-x-2\">\n<div class=\"w-2 h-2 rounded-full bg-primary\"></div>\n<span class=\"text-xs text-on-surface-variant\">Actual</span>\n</div>\n<div class=\"flex items-center space-x-2\">\n<div class=\"w-2 h-2 rounded-full bg-surface-container-highest\"></div>\n<span class=\"text-xs text-on-surface-variant\">Planned</span>\n</div>\n</div>\n<!-- History List -->\n<div class=\"space-y-4\">\n<!-- Day Entry 1 -->\n<div class=\"group flex items-center justify-between p-4 bg-surface-container-low rounded-xl transition-colors hover:bg-surface-container-high\">\n<div class=\"flex flex-col\">\n<span class=\"font-headline font-bold text-lg text-on-surface\">Tue 14</span>\n<span class=\"font-body text-[10px] text-on-surface-variant uppercase tracking-wider\">Yesterday</span>\n</div>\n<div class=\"flex flex-col items-end flex-1 ml-8\">\n<div class=\"w-full max-w-[120px] h-1.5 bg-surface-container-highest rounded-full overflow-hidden relative\">\n<div class=\"absolute top-0 left-0 h-full bg-primary rounded-full\" style=\"width: 93%;\"></div>\n</div>\n<p class=\"mt-2 font-headline font-bold text-sm text-on-surface\">\n                                7.5h <span class=\"text-on-surface-variant font-medium\">/ 8h</span>\n</p>\n</div>\n</div>\n<!-- Day Entry 2 -->\n<div class=\"group flex items-center justify-between p-4 bg-surface-container-low rounded-xl transition-colors hover:bg-surface-container-high\">\n<div class=\"flex flex-col\">\n<span class=\"font-headline font-bold text-lg text-on-surface\">Mon 13</span>\n<span class=\"font-body text-[10px] text-on-surface-variant uppercase tracking-wider\">Stable</span>\n</div>\n<div class=\"flex flex-col items-end flex-1 ml-8\">\n<div class=\"w-full max-w-[120px] h-1.5 bg-surface-container-highest rounded-full overflow-hidden relative\">\n<div class=\"absolute top-0 left-0 h-full bg-primary rounded-full\" style=\"width: 100%;\"></div>\n</div>\n<p class=\"mt-2 font-headline font-bold text-sm text-on-surface\">\n                                8.2h <span class=\"text-on-surface-variant font-medium\">/ 8h</span>\n</p>\n</div>\n</div>\n<!-- Day Entry 3 -->\n<div class=\"group flex items-center justify-between p-4 bg-surface-container-low rounded-xl transition-colors hover:bg-surface-container-high\">\n<div class=\"flex flex-col\">\n<span class=\"font-headline font-bold text-lg text-on-surface\">Sun 12</span>\n<span class=\"font-body text-[10px] text-on-surface-variant uppercase tracking-wider text-tertiary\">Shortfall</span>\n</div>\n<div class=\"flex flex-col items-end flex-1 ml-8\">\n<div class=\"w-full max-w-[120px] h-1.5 bg-surface-container-highest rounded-full overflow-hidden relative\">\n<div class=\"absolute top-0 left-0 h-full bg-primary rounded-full\" style=\"width: 65%;\"></div>\n</div>\n<p class=\"mt-2 font-headline font-bold text-sm text-on-surface\">\n                                5.2h <span class=\"text-on-surface-variant font-medium\">/ 8h</span>\n</p>\n</div>\n</div>\n<!-- Placeholder for previous days -->\n<div class=\"flex flex-col space-y-4 opacity-50\">\n<div class=\"flex items-center justify-between p-4 bg-surface-container-low rounded-xl\">\n<span class=\"font-headline font-bold text-lg text-on-surface\">Sat 11</span>\n<p class=\"font-headline font-bold text-sm text-on-surface\">7.8h <span class=\"text-on-surface-variant font-medium\">/ 8h</span></p>\n</div>\n<div class=\"flex items-center justify-between p-4 bg-surface-container-low rounded-xl\">\n<span class=\"font-headline font-bold text-lg text-on-surface\">Fri 10</span>\n<p class=\"font-headline font-bold text-sm text-on-surface\">8.1h <span class=\"text-on-surface-variant font-medium\">/ 8h</span></p>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Management Section -->\n<section class=\"mb-12\">\n<h3 class=\"font-headline font-bold text-xl text-on-surface mb-6\">Management</h3>\n<div class=\"flex flex-col space-y-4\">\n<!-- Export Button -->\n<button class=\"w-full py-5 px-6 rounded-full bg-gradient-to-br from-primary to-primary-container text-on-primary-container flex items-center justify-between group active:scale-95 transition-all\">\n<span class=\"font-headline font-bold text-lg\">Export Data to JSON</span>\n<span class=\"material-symbols-outlined\" data-icon=\"ios_share\">ios_share</span>\n</button>\n<!-- Clear Button -->\n<button class=\"w-full py-5 px-6 rounded-full bg-surface-container-high text-on-surface flex items-center justify-between group active:scale-95 transition-all\">\n<span class=\"font-headline font-bold text-lg text-error\">Clear All Data</span>\n<span class=\"material-symbols-outlined text-error\" data-icon=\"delete_forever\">delete_forever</span>\n</button>\n<p class=\"text-center text-[10px] text-on-surface-variant uppercase tracking-[0.2em] pt-4\">\n                    Data management actions are permanent\n                </p>\n</div>\n</section>\n</main>\n<!-- BottomNavBar Shell -->\n<nav class=\"fixed bottom-0 left-0 w-full flex justify-around items-center px-8 pb-8 pt-4 bg-[#37393e]/60 dark:bg-[#37393e]/60 backdrop-blur-xl z-50 rounded-t-[2rem] shadow-[0_-8px_32px_rgba(226,226,232,0.06)]\">\n<!-- Bedtime (Inactive) -->\n<a class=\"flex flex-col items-center justify-center text-[#e2e2e8]/50 p-3 hover:text-[#acc7ff] transition-colors tap-highlight-none active:scale-95 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"bedtime\">bedtime</span>\n<span class=\"font-['Inter'] text-[10px] font-medium tracking-wider uppercase mt-1\">Rest</span>\n</a>\n<!-- Analytics (Inactive) -->\n<a class=\"flex flex-col items-center justify-center text-[#e2e2e8]/50 p-3 hover:text-[#acc7ff] transition-colors tap-highlight-none active:scale-95 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"analytics\">analytics</span>\n<span class=\"font-['Inter'] text-[10px] font-medium tracking-wider uppercase mt-1\">Pulse</span>\n</a>\n<!-- History (Active) -->\n<a class=\"flex flex-col items-center justify-center bg-[#282a2e] text-[#acc7ff] rounded-full p-3 tap-highlight-none active:scale-95 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\" style=\"font-variation-settings: 'FILL' 1;\">history</span>\n<span class=\"font-['Inter'] text-[10px] font-medium tracking-wider uppercase mt-1\">History</span>\n</a>\n<!-- Settings (Inactive) -->\n<a class=\"flex flex-col items-center justify-center text-[#e2e2e8]/50 p-3 hover:text-[#acc7ff] transition-colors tap-highlight-none active:scale-95 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"settings\">settings</span>\n<span class=\"font-['Inter'] text-[10px] font-medium tracking-wider uppercase mt-1\">Setup</span>\n</a>\n</nav>\n</body></html>"}
